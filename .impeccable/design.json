  "narrative": {
    "northStar": "The Man Page",
    "overview": "The conversation is set like a manual page. Rank comes from weight and case, state from a mark and a word, and colour is held back for what needs it.",
    "keyCharacteristics": [
      "One ochre accent on at most a tenth of any screen",
      "Hierarchy from bold, capitals and indent",
      "Monospace everywhere",
      "Meaning is never carried by colour alone"
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "The accent marks state and choice, never decoration.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor Rule",
        "body": "Every text colour is held to 4.5:1 against the background it sits on.",
        "section": "colors"
      },
      {
        "name": "The Plain Separator Rule",
        "body": "Separators are ASCII: ` * ` between parts, `*`, `-`, `+` markers, `[x]` boxes.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces are flat at rest; state is shown by tone and a mark, not by shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the one accent for state and choice and let weight, case and indent do the rest.",
      "Do keep touch targets at 44px under a coarse pointer."
    ],
    "donts": [
      "Don't use gradient text, coloured stripes, glow shadows or accent-coloured borders.",
      "Don't carry meaning by colour alone."
    ]
  }
