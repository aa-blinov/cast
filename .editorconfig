# EditorConfig — https://editorconfig.org
#
# The standard's own rule: every text file ends in a newline, uses LF, and
# uses no trailing whitespace. The editorconfig covers the rest: indentation
# width, final newline, charset.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown is prose. Two-space indentation keeps list continuations and
# nested code fences aligned without pushing the prose to a tab width that
# looks like a table.
trim_trailing_whitespace = false

[*.{py,js,ts,tsx,jsx,json,yaml,yml,toml}]
indent_size = 2

[*.py]
indent_size = 4

[*.{go,rs,java,c,cpp,h,hpp}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
