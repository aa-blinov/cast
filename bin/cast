#!/bin/bash
# Release launcher (macOS/Linux) — runs the pre-built dist/index.js bundle.
# Unlike cast.sh (repo root, dev mode), the JavaScript dependencies are
# bundled into dist/index.js at release-build time (see scripts/build.mjs).
# The release archive also carries node-pty because its native addon cannot
# be embedded in the bundle.
ORIGINAL_CWD="$(pwd)"

# Resolve the real script location through any number of symlinks —
# install.sh symlinks this into a directory on PATH (e.g. ~/.local/bin),
# and `dirname "$0"` alone would resolve to the symlink's directory instead
# of where dist/ actually lives relative to this file.
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -h "$SOURCE" ]; do
	DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	[[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# `cast --version` alone is answered here: loading the bundle just to print one line cost ~0.7s of every call.
# package.json ships next to bin/ in the release archive (and sits in the repo root in dev).
if [ "$#" -eq 1 ] && { [ "$1" = "--version" ] || [ "$1" = "-v" ]; }; then
	VERSION="$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' "$SCRIPT_DIR/../package.json" 2>/dev/null | head -n 1)"
	if [ -n "$VERSION" ]; then
		echo "cast v$VERSION"
		exit 0
	fi
fi

# DEP0040 comes from OpenAI's unused bundled node-fetch fallback. node:sqlite
# is intentionally used by cast but remains experimental in Node 22. Keep
# other warnings visible instead of suppressing the process-wide warning stream.
# --max-semi-space-size=64: the daemon streams many small objects (SSE events,
# provider chunks); a bigger young generation means fewer, amortized minor GCs.
# NODE_COMPILE_CACHE keeps V8's compiled code for dist/index.js between runs
# (Node 22.1+; older ones ignore it): compiling the 5MB bundle was a quarter
# of every start, ~0.4s. The daemon the TUI starts inherits it.
exec env CAST_CWD="$ORIGINAL_CWD" NODE_COMPILE_CACHE="${NODE_COMPILE_CACHE:-$HOME/.cast/cache/compile}" node --disable-warning=DEP0040 --disable-warning=ExperimentalWarning --max-semi-space-size=64 "$SCRIPT_DIR/../dist/index.js" "$@"
