{
	"name": "cast",
	"version": "0.60.0",
	"description": "Role-based terminal agent harness with seven built-in personas",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"bin": {
		"cast": "./cast.sh"
	},
	"scripts": {
		"start": "node --disable-warning=DEP0040 --disable-warning=ExperimentalWarning --import tsx ./src/index.ts",
		"prestart": "node ./scripts/build-monos-elements.mjs",
		"prepare": "bash scripts/install-hooks.sh",
		"hooks:install": "bash scripts/install-hooks.sh",
		"pty:fix": "node scripts/fix-pty-helper.mjs",
		"setup": "bash scripts/install-hooks.sh && node scripts/fix-pty-helper.mjs",
		"build": "node ./scripts/build.mjs",
		"check": "tsc --noEmit && biome check src/ test/",
		"lint": "biome check src/ test/",
		"format": "biome format --write src/ test/",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"coverage:check": "node scripts/check-coverage-floor.mjs",
		"coverage:sync": "node scripts/sync-coverage-baseline.mjs",
		"soak:tui": "node scripts/soak-tui.mjs",
		"e2e:plan": "bash scripts/e2e-plan-mode.sh",
		"e2e:jsonl": "bash scripts/e2e-server-jsonl.sh",
		"e2e:hooks": "bash scripts/e2e-server-hooks.sh",
		"e2e:compaction": "node --import tsx scripts/e2e-compaction.mjs",
		"e2e:memory": "node --import tsx scripts/e2e-memory.mjs",
		"e2e:web-model": "node scripts/e2e-web-model-flow.mjs",
		"e2e:docs": "node scripts/e2e-docs-site.mjs",
		"build-site": "node --import tsx scripts/build-site.mjs",
		"dev:web": "node ./scripts/build-monos-elements.mjs && node --disable-warning=DEP0040 --disable-warning=ExperimentalWarning --import tsx ./src/server/index.ts",
		"build:monos-elements": "node ./scripts/build-monos-elements.mjs"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "~2.0.2",
		"@anthropic-ai/sandbox-runtime": "^0.0.81",
		"@earendil-works/pi-tui": "^1.4.0",
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/resize": "^2.1.1",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@types/react": "^19.3.0",
		"get-east-asian-width": "^1.7.0",
		"highlight.js": "^11.12.0",
		"htmlparser2": "^12.0.0",
		"node-pty": "^1.1.0",
		"openai": "^7.43.0",
		"pptxgenjs": "^4.0.1",
		"react": "^19.3.1",
		"react-reconciler": "^0.34.0",
		"tree-sitter-bash": "^0.25.1",
		"tsx": "^4.23.15",
		"turndown": "^7.2.4",
		"undici": "^8.12.2",
		"web-tree-sitter": "^0.27.1",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"zod": "^4.6.7",
		"pptxgenjs": {
			"image-size": "^2.0.4"
		}
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "^13.1.0",
		"@biomejs/biome": "2.6.3",
		"@monos/ui": "git+https://github.com/aa-blinov/monos-ui.git#v1.5.3",
		"@types/node": "^26.1.0",
		"@types/react-reconciler": "^0.34.1",
		"@types/turndown": "^5.0.6",
		"@vitest/coverage-v8": "^5.0.5",
		"ajv": "^8.20.0",
		"esbuild": "^0.28.2",
		"marked": "^18.1.1",
		"playwright": "^1.64.1",
		"string-width": "^8.3.0",
		"svelte": "^5.57.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
